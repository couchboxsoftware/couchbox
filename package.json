{
  "name": "couchbox",
  "productName": "Couchbox",
  "version": "0.3.13",
  "description": "Your home video library, streaming-style.",
  "main": "main.js",
  "author": "Couchbox Software",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/couchboxsoftware/couchbox.git"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "snap": "electron test/snap.js",
    "dist": "electron-builder --win --publish never",
    "release": "node tools/release.js"
  },
  "build": {
    "appId": "app.couchbox.player",
    "productName": "Couchbox",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "build/icon.png",
      "build/tray/*.png",
      "CHANGELOG.md",
      "node_modules/**/*",
      "!test/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "src/main/intro-worker.js"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "include": "build/installer.nsh",
      "shortcutName": "Couchbox",
      "artifactName": "Couchbox-Setup-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "couchboxsoftware",
      "repo": "couchbox",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11",
    "ffmpeg-static": "5.3.0"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron-winstaller@5.4.0": true
  }
}
